<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Reporting.Benchmarks</RootNamespace>
    <AssemblyName>Reporting.Benchmarks</AssemblyName>
    <!-- Belt and braces: Directory.Build.props already forces IsPackable=false for *.Benchmarks, but a
         benchmark harness must never reach NuGet.org even if that condition is ever edited. -->
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet refuses to run a Debug build; make the intent explicit for anyone invoking it. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reporting.CodeFirst\Reporting.CodeFirst.csproj" />
    <ProjectReference Include="..\..\src\Reporting.DataSources\Reporting.DataSources.csproj" />
    <ProjectReference Include="..\..\src\Reporting.Expressions\Reporting.Expressions.csproj" />
    <ProjectReference Include="..\..\src\Reporting.Layout\Reporting.Layout.csproj" />
    <ProjectReference Include="..\..\src\Reporting.Output.Excel\Reporting.Output.Excel.csproj" />
    <ProjectReference Include="..\..\src\Reporting.Output.Pdf\Reporting.Output.Pdf.csproj" />
  </ItemGroup>

</Project>
