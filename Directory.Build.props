<Project>

  <PropertyGroup>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
    <NeutralLanguage>en</NeutralLanguage>
    <Authors>OmniReport contributors</Authors>
    <Company>OmniReport</Company>
    <Product>OmniReport</Product>
    <Copyright>Copyright (c) OmniReport contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <!-- Versão de desenvolvimento da main. Estava em 0.1.0-alpha enquanto a 0.1.0 E a 0.1.1 já
         estavam publicadas no nuget.org — ou seja, o default do repo apontava para TRÁS do que já
         havia sido entregue. Passava despercebido porque o release.yml sobrescreve com a tag; quem
         rodasse `dotnet pack` local gerava um pacote mais velho que o publicado. O Package Validation
         é o que tornou isso visível (CP0003). A main acumula breaking changes desde a 0.1.1, então o
         próximo número é 0.2.0. -->
    <Version>0.2.0-alpha</Version>

    <!-- Metadados de pacote NuGet compartilhados por todo projeto empacotável.
         OBS: o PackageId NÃO fica aqui — ele é definido só para os projetos de biblioteca
         (grupo condicional abaixo), senão o prefixo vazaria para o sample/testes e mudaria
         o nome do bundle de CSS scoped do app ({PackageId}.styles.css), gerando 404. -->
    <PackageProjectUrl>https://github.com/afernandes/Omni.Report</PackageProjectUrl>
    <RepositoryUrl>https://github.com/afernandes/Omni.Report</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>reporting;report;pdf;banded-report;blazor;skiasharp;barcode;nfce;ssrs;dotnet</PackageTags>
    <PackageReleaseNotes>Consulte o CHANGELOG.md no repositório.</PackageReleaseNotes>

    <!-- Símbolos (.snupkg) + SourceLink (debug apontando para o GitHub) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Projetos de biblioteca (Core + engines): warnings-as-errors E o PackageId com o
       prefixo de marca no nuget.org. Restrito aqui (não global) para o prefixo NUNCA
       vazar para apps de sample / testes — um PackageId errado no sample BlazorServer
       renomeia o bundle de CSS scoped ({PackageId}.styles.css) e dá 404 nos estilos. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Reporting.')) and !$(MSBuildProjectName.EndsWith('.Tests')) and !$(MSBuildProjectName.EndsWith('.Benchmarks')) and !$(MSBuildProjectName.Contains('.Samples'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!-- AssemblyName/RootNamespace/_content seguem Reporting.*; só o ID do pacote muda. -->
    <PackageId>AndersonN.Omni.Report.$(MSBuildProjectName.Replace('Reporting.', ''))</PackageId>

    <!-- GATE DE BREAKING CHANGE. Com 39 pacotes interdependentes, uma mudança em Reporting.Core podia
         quebrar consumidores dos outros 38 sem nenhum aviso — o sinal dependia só de disciplina humana
         no Conventional Commit. O Package Validation do SDK compara o pacote sendo gerado com o que foi
         REALMENTE publicado no nuget.org e falha o `pack` numa quebra.

         Escolhido em vez do PublicApiAnalyzers porque cobre os 39 pacotes de uma vez, não exige um
         PublicAPI.Shipped.txt por projeto (dezenas de milhares de linhas para manter à mão) e compara
         contra o artefato entregue em vez de contra um arquivo que também pode ficar desatualizado.

         As quebras que já aconteceram entre a 0.1.1 e hoje ficam registradas em
         CompatibilitySuppressions.xml — o arquivo é a lista auditável do que quebrou, e serve de
         insumo para as notas da 0.2.0. A partir daqui, quebra NOVA falha o build.

         Requer rede no `pack` (baixa o pacote de baseline). `build` e `test` não são afetados. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(PackageValidationBaselineVersion)' == ''">0.1.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Test and benchmark projects: more permissive, and NEVER packable.
       `.Benchmarks` is excluded here AND from the PackageId group above deliberately: a project named
       Reporting.* is packable by SDK default, so without this `dotnet pack OmniReport.slnx` would publish the
       benchmark harness to NuGet.org — the same class of defect that shipped Printing.Android as a stub. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.Benchmarks'))">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

  <!-- Embute o README do repositório em cada pacote (aba "Readme" na página do NuGet) -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
