@namespace Reporting.Designer.Blazor.Icons

<svg xmlns="http://www.w3.org/2000/svg"
     width="@Size" height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.5"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@CssClass"
     aria-hidden="true">
    @((MarkupString)IconCatalog.GetPath(Name))
</svg>
