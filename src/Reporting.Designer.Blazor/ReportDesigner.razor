@namespace Reporting.Designer.Blazor
@implements IAsyncDisposable
@inject IJSRuntime Js

<CascadingValue Value="State.History">
<div class="report-designer" tabindex="0"
     @onkeydown="OnKeyDown" @ref="_rootRef">
    @if (State.IsPreviewing && _previewDiagnostics.Count > 0)
    {
        <div class="pagination-warning" role="alert">
            <strong>Preview com limitações</strong>
            @foreach (var message in _previewDiagnostics) { <p>@message</p> }
        </div>
    }
    <div class="app" id="app">
        <TopBar DocumentName="@State.Report.Name"
                IsDarkTheme="@(State.Theme == "dark")"
                OnToggleTheme="OnToggleTheme"
                OnOpenPalette="OnOpenPalette"
                OnSave="OnSave"
                OnLoad="OnLoadFile"
                OnLoadRdl="OnLoadRdlFile"
                OnMenuCommand="OnMenuCommand" />

        <TabBar Tabs="State.Tabs"
                ActiveTab="State.ActiveTab"
                Activate="OnActivateTab"
                Close="OnCloseTab"
                OnNew="OnNewTab" />

        <Toolbar CanUndo="State.History.CanUndo"
                 CanRedo="State.History.CanRedo"
                 HasSelection="@(State.SelectedElement is not null)"
                 HasClipboard="@(State.Clipboard.Count > 0)"
                 MultiSelected="@(State.SelectedElements.Count > 1)"
                 CanDistribute="@(State.SelectedElements.Count >= 3)"
                 GridVisible="State.GridVisible"
                 SnapEnabled="State.SnapToGrid"
                 RulersVisible="State.RulersVisible"
                 Zoom="State.Zoom"
                 OnUndo="OnUndo"
                 OnRedo="OnRedo"
                 OnDelete="OnDeleteSelected"
                 OnPreview="OnPreview"
                 OnCut="OnCut"
                 OnCopy="OnCopy"
                 OnPaste="OnPaste"
                 OnPageSetup="OnOpenPageSetup"
                 OnInsert="OnInsert"
                 OnToggleGrid="v => State.GridVisible = v"
                 OnToggleSnap="v => State.SnapToGrid = v"
                 OnToggleRulers="v => State.RulersVisible = v"
                 OnZoomChange="v => State.Zoom = v"
                 OnAlignLeft="() => Align(AlignOp.Left)"
                 OnAlignCenterH="() => Align(AlignOp.CenterH)"
                 OnAlignRight="() => Align(AlignOp.Right)"
                 OnAlignTop="() => Align(AlignOp.Top)"
                 OnAlignMiddleV="() => Align(AlignOp.MiddleV)"
                 OnAlignBottom="() => Align(AlignOp.Bottom)"
                 OnDistributeH="() => Align(AlignOp.DistributeH)"
                 OnDistributeV="() => Align(AlignOp.DistributeV)"
                 OnSameWidth="() => Align(AlignOp.SameWidth)"
                 OnSameHeight="() => Align(AlignOp.SameHeight)"
                 OnSameBoth="() => Align(AlignOp.SameBoth)"
                 OnBringForward="() => ChangeZOrder(+1)"
                 OnSendBackward="() => ChangeZOrder(-1)"
                 OnBringToFront="BringToFront"
                 OnSendToBack="SendToBack" />

        <div class="workspace">
            <LeftPanel DataSources="State.DataSources"
                       OnAddSystemField="OnAddSystemField"
                       OnEditDataSource="OnEditDataSource"
                       Parameters="State.Parameters"
                       Relations="State.Relations"
                       OnAdd="OnInsert"
                       OnAddParameter="OnAddParameter"
                       OnRemoveParameter="OnRemoveParameter"
                       Variables="State.Variables"
                       OnAddVariable="OnAddVariable"
                       OnRemoveVariable="OnRemoveVariable"
                       OnAddDataSource="OnAddDataSource" />

            <CanvasRegion Report="State.Report"
                          Selected="State.SelectedElement"
                          SelectionChanged="OnSelectionChanged"
                          ActiveBand="State.ActiveBand"
                          ActiveBandChanged="OnActiveBandChanged"
                          GridVisible="State.GridVisible"
                          RulersVisible="State.RulersVisible"
                          SnapToGrid="State.SnapToGrid"
                          Zoom="State.Zoom"
                          DataSources="State.DataSources"
                          Relations="State.Relations"
                          Parameters="State.Parameters"
                          IsPreviewing="State.IsPreviewing"
                          PreviewPages="_previewPages"
                          PreviewCurrentPage="_previewCurrentPage"
                          OnExitPreview="ClosePreview"
                          OnPreviewPageChanged="i => _previewCurrentPage = i"
                          Exporters="_exporterDescriptors"
                          OnExport="OnExport"
                          OnPrint="OnPrint"
                          PreviewZoom="_previewZoom"
                          PreviewZoomChanged="v => _previewZoom = v" />

            <RightPanel Report="State.Report"
                        Selected="State.SelectedElement"
                        Selection="State.SelectedElements"
                        BandLabel="@CurrentBandLabel"
                        ActiveBand="State.ActiveBand"
                        OnBandActivated="OnActiveBandChanged"
                        DataSources="State.DataSources"
                        Relations="State.Relations"
                        Parameters="State.Parameters"
                        OnSelect="OnSelectionChanged"
                        OnOpenExpressionEditor="OpenExpressionEditor" />
        </div>

        <StatusBar SelectedX="@(State.SelectedElement?.X.ToMm() ?? 0)"
                   SelectedY="@(State.SelectedElement?.Y.ToMm() ?? 0)"
                   SelectedW="@(State.SelectedElement?.Width.ToMm() ?? 0)"
                   SelectedH="@(State.SelectedElement?.Height.ToMm() ?? 0)"
                   Zoom="State.Zoom"
                   PaperLabel="@PaperLabel"
                   BandCount="State.Report.Bands.Count"
                   ElementCount="TotalElementCount"
                   SelectionCount="State.SelectedElements.Count"
                   ErrorCount="TotalExpressionErrors"
                   IsDirty="State.IsDirty"
                   DataSourceName="@(State.DataSources.FirstOrDefault()?.Name ?? "—")"
                   DataSourceKind="@DataSourceKindLabel"
                   DataSourceCount="State.DataSources.Count" />

        <CommandPalette Visible="State.CommandPaletteOpen"
                        OnClose="() => State.CommandPaletteOpen = false"
                        OnExecute="OnPaletteCommand" />

        <PageSetupDialog Visible="_pageSetupOpen"
                         InitialPageSetup="State.Report.PageSetup"
                         OnApplied="OnPageSetupApplied"
                         OnClosed="() => _pageSetupOpen = false" />

        <PrintDialog Visible="_printDialogOpen"
                     PreviewPages="_previewPages"
                     CurrentPage="_previewCurrentPage"
                     TotalPages="@(_previewRendered?.PageCount ?? 0)"
                     DocumentPaper="@State.Report.PageSetup.Paper.Name"
                     DocumentOrientation="State.Report.PageSetup.Orientation"
                     OnPrint="OnPrintConfirmed"
                     OnClosed="() => _printDialogOpen = false" />

        <ExpressionEditorDialog Visible="_expressionEditorOpen"
                                InitialExpression="@CurrentEditedExpression()"
                                DataSources="State.DataSources"
                                Parameters="State.Parameters"
                                Theme="@State.Theme"
                                OnApplied="OnExpressionApplied"
                                OnClosed="@(() => { _expressionEditorOpen = false; _bindingPath = null; })" />

        <ContextMenu Visible="_ctxVisible"
                     X="_ctxX" Y="_ctxY"
                     Items="_ctxItems"
                     OnClose="CloseContextMenu" />

        <DataSourceEditorDialog Visible="_dsEditorOpen"
                                Source="_dsEditing"
                                Parameters="State.Parameters.ToList()"
                                AllDataSources="State.DataSources.ToList()"
                                Relations="State.Relations"
                                Theme="@(State.Theme == "dark" ? "vs-dark" : "vs")"
                                OnApplied="OnDataSourceApplied"
                                OnDelete="OnDataSourceDeleted"
                                OnClosed="() => _dsEditorOpen = false" />

        <ParameterPromptDialog Visible="_paramPromptOpen"
                               Parameters="State.Parameters.ToList()"
                               InitialValues="_paramValues"
                               ResolveOptions="ResolveParameterOptionsAsync"
                               OnConfirmed="OnParameterPromptConfirmed"
                               OnCancelled="OnParameterPromptCancelled" />

        <GroupBindingDialog Visible="_groupEditorOpen"
                            Band="_groupEditing"
                            DataSources="State.DataSources"
                            OnApplied="StateHasChanged"
                            OnClosed="() => _groupEditorOpen = false" />

        @* RDL band properties — opens via context menu / command palette / outline.
           Surfaces PageBreak (every band), NoRowsMessage (Detail/SubDetail), Filter +
           Sort (Detail/SubDetail/Group), Variables (Group). *@
        <BandPropertiesDialog Visible="_bandPropsOpen"
                              Band="_bandPropsEditing"
                              OnClose="() => _bandPropsOpen = false" />

        @* Sobre — mostra a versão REAL lida do assembly e o runtime corrente (sem strings fixas). *@
        <DesignerModal Visible="_aboutOpen" Title="Sobre o OmniReport" HeadIcon="info"
                       CloseOnBackdrop="true" OnClose="() => _aboutOpen = false">
            <div style="display:flex;flex-direction:column;gap:12px;min-width:320px;font-size:13px;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <span style="width:34px;height:34px;border-radius:8px;background:linear-gradient(135deg,#C2410C,#A16207);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:18px;">R</span>
                    <div>
                        <div style="font-weight:700;font-size:15px;">OmniReport</div>
                        <div style="color:var(--text-tertiary);">Designer de relatórios</div>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:auto 1fr;gap:4px 14px;">
                    <span style="color:var(--text-tertiary);">Versão</span><span>@AppVersion</span>
                    <span style="color:var(--text-tertiary);">Runtime</span><span>@RuntimeLabel</span>
                </div>
                <p style="color:var(--text-secondary);margin:0;line-height:1.5;">
                    Motor de relatórios bandado para .NET — design code-first ou visual, com exportação
                    para PDF, XLSX, HTML, SVG, CSV, JSON e Markdown.
                </p>
            </div>
        </DesignerModal>

        <!-- Hidden file input used when the user picks 'open' from menu/palette. -->
        <InputFile id="__designer_repx_input" style="display:none" OnChange="OnLoadFile" accept=".repx" />

        <!-- Compat affordances for the bUnit harness: a snap checkbox and a
             screen-reader-only list of band display labels (so plain text queries pass). -->
        <label style="position:absolute;left:-9999px;width:0;height:0;overflow:hidden;">
            <input type="checkbox" checked="@State.SnapToGrid"
                   @onchange="@(e => State.SnapToGrid = (bool)(e.Value ?? false))" />
            Snap to grid
        </label>
        <div style="position:absolute;left:-9999px;width:0;height:0;overflow:hidden;" aria-hidden="true">
            @foreach (var band in State.Report.Bands)
            {
                <span>@band.DisplayLabel</span>
            }
        </div>
    </div>
</div>

</CascadingValue>
