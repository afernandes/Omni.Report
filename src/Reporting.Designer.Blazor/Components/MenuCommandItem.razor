@namespace Reporting.Designer.Blazor.Components

@if (Command.StartsGroup)
{
    <div class="dropdown-sep"></div>
}
<button class="dropdown-item" type="button" disabled="@Disabled" @onclick="Select">
    <Icon Name="@Command.Icon" Size="12" CssClass="icon icon-12" /><span>@Command.Title</span><span class="shortcut">@Command.Shortcut</span>
</button>
