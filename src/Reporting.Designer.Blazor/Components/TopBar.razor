@namespace Reporting.Designer.Blazor.Components

<header class="topbar no-select">
    <div class="brand">
        <span class="brand-mark">R</span>
        <span>Report Designer</span>
        @if (!string.IsNullOrEmpty(DocumentName))
        {
            <span class="crumb">· @DocumentName</span>
        }
    </div>

    <nav class="menu" aria-label="Menu principal">
        @* Menus come from the Designer's command list (DesignerCommandCatalog) — the same list the command palette and
           the shortcuts dialog use — so a command cannot be missing from one place or advertise a different shortcut.
           Only Arquivo has hand-written items: opening a file needs a real <InputFile> the user clicks. *@
        <DropdownMenu Label="Arquivo">
            @if (CommandsOf("Arquivo").FirstOrDefault() is { } first)
            {
                <MenuCommandItem Command="first" OnSelect="OnMenuCommand" />
            }
            @* The no-op @onclick + stopPropagation keep the dropdown OPEN while the OS file dialog is up:
               the panel's @onclick would otherwise close the menu, removing this <InputFile> from the DOM
               before OnChange can fire (the file would silently never open). The label still triggers its
               wrapped <InputFile> natively. *@
            <label class="dropdown-item" style="cursor:pointer;" @onclick="NoOp" @onclick:stopPropagation="true">
                <Icon Name="folder-open" Size="12" CssClass="icon icon-12" />
                <span>Abrir .repx…</span>
                <span class="shortcut">Ctrl+O</span>
                <InputFile OnChange="OnLoadFile" accept=".repx" style="display:none" />
            </label>
            <label class="dropdown-item" style="cursor:pointer;" @onclick="NoOp" @onclick:stopPropagation="true">
                <Icon Name="folder-open" Size="12" CssClass="icon icon-12" />
                <span>Importar RDL…</span>
                <span class="shortcut"></span>
                <InputFile OnChange="OnLoadRdlFile" accept=".rdl" style="display:none" />
            </label>
            @* file.open is the <label> above (a real InputFile); the palette reaches it through the same id. *@
            @foreach (var command in CommandsOf("Arquivo").Skip(1).Where(c => c.Id != "file.open"))
            {
                <MenuCommandItem Command="command" OnSelect="OnMenuCommand" Disabled="@(IsBusy && IsOutputCommand(command))" />
            }
        </DropdownMenu>
        @foreach (var menu in Reporting.Designer.Blazor.Services.DesignerCommandCatalog.Menus.Skip(1))
        {
            var items = CommandsOf(menu).ToList();
            @if (items.Count > 0)
            {
                <DropdownMenu Label="@menu">
                    @foreach (var command in items)
                    {
                        <MenuCommandItem Command="command" OnSelect="OnMenuCommand" />
                    }
                </DropdownMenu>
            }
        }
    </nav>

    <button class="cmd-trigger" type="button" @onclick="OnOpenPaletteClicked" aria-label="Command palette">
        <Icon Name="search" Size="14" />
        <span class="cmd-text">Buscar comando ou propriedade…</span>
        <span class="cmd-kbd">
            <kbd>Ctrl</kbd><kbd>K</kbd>
        </span>
    </button>

    <div class="topbar-right">
        <label class="icon-btn" type="button" title="Abrir .repx (Ctrl+O)" style="cursor:pointer;">
            <Icon Name="folder-open" Size="16" />
            <InputFile data-designer-open="true" style="display:none" OnChange="OnLoadFile" accept=".repx" />
        </label>
        <button class="icon-btn" type="button" title="Salvar (Ctrl+S)" @onclick="OnSaveClicked"><Icon Name="save" Size="16" /></button>
        <button class="icon-btn" type="button" title="Validar relatório" @onclick="@(() => OnMenuCommand.InvokeAsync("report.validate"))"><Icon Name="shield-check" Size="16" /></button>
        <div class="div-v"></div>
        <button class="icon-btn" type="button" title="Tema (Ctrl+Shift+L)" @onclick="OnToggleThemeClicked">
            @if (IsDarkTheme)
            {
                <Icon Name="sun" Size="16" />
            }
            else
            {
                <Icon Name="moon" Size="16" />
            }
        </button>
        <button class="icon-btn" type="button" title="Configuração de página" @onclick="@(() => OnMenuCommand.InvokeAsync("report.pagesetup"))"><Icon Name="settings" Size="16" /></button>
    </div>
</header>
