<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Reporting.Layout</RootNamespace>
    <AssemblyName>Reporting.Layout</AssemblyName>
    <Description>OmniReport — banded layout engine producing positioned LayoutPrimitives ready to be consumed by any IRenderingContext.</Description>
    <!-- Trava de documentação: toda API pública deste projeto precisa de <summary>. O Replace levanta a
         supressão global de CS1591 (Directory.Build.props) só para ESTE projeto; junto com o
         TreatWarningsAsErrors das bibliotecas empacotáveis, o build falha enquanto houver membro público sem
         doc — e continua falhando se um novo chegar sem ela. Mesmo padrão de CodeFirst (#208), Core e
         Rendering (#236). -->
    <NoWarn>$(NoWarn.Replace(';CS1591','').Replace('CS1591',''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reporting.Barcode\Reporting.Barcode.csproj" />
    <ProjectReference Include="..\Reporting.Core\Reporting.Core.csproj" />
    <ProjectReference Include="..\Reporting.Expressions\Reporting.Expressions.csproj" />
    <ProjectReference Include="..\Reporting.DataSources\Reporting.DataSources.csproj" />
    <ProjectReference Include="..\Reporting.Rendering\Reporting.Rendering.csproj" />
  </ItemGroup>

</Project>
