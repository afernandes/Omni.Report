<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Reporting.Output.Pdf</RootNamespace>
    <AssemblyName>Reporting.Output.Pdf</AssemblyName>
    <Description>OmniReport — vector-native PDF exporter via SkiaSharp. Text remains selectable.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reporting.Core\Reporting.Core.csproj" />
    <ProjectReference Include="..\Reporting.Layout\Reporting.Layout.csproj" />
    <ProjectReference Include="..\Reporting.Output\Reporting.Output.csproj" />
    <ProjectReference Include="..\Reporting.Rendering\Reporting.Rendering.csproj" />
    <ProjectReference Include="..\Reporting.Rendering.Skia\Reporting.Rendering.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <!-- Subsetting de fontes. O libSkiaSharp distribuído é compilado SEM HarfBuzz, então o subsetter interno do
         Skia (SkPDFSubsetFont) é o stub que devolve nulo e o PDF embutia cada fonte INTEIRA — mesmo com o prefixo
         "ABCDEF+" no nome. O nativo do HarfBuzzSharp traz o hb-subset; o wrapper gerenciado não o expõe, por isso
         HarfBuzzSubsetter chama a API C diretamente. O pacote de Linux é à parte, como o do SkiaSharp. -->
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>

</Project>
