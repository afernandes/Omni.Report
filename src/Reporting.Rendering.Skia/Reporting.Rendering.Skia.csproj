<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Reporting.Rendering.Skia</RootNamespace>
    <AssemblyName>Reporting.Rendering.Skia</AssemblyName>
    <Description>OmniReport — SkiaSharp implementation of IRenderingContext. Produces PNG/SVG/PDF output from layout primitives.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reporting.Core\Reporting.Core.csproj" />
    <ProjectReference Include="..\Reporting.Rendering\Reporting.Rendering.csproj" />
  </ItemGroup>

  <!-- O test project se chama Reporting.Rendering.Tests (não .Skia.Tests), então a convenção
       global de Directory.Build.props ($(MSBuildProjectName).Tests) não o cobre. Expomos os
       internals (SkiaConversions: Px/ToSKFontStyle/ToSKDashEffect) só para esses testes puros
       de conversão, que não têm como ser cobertos via API pública de pixels. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Reporting.Rendering.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <!-- O metapacote base do SkiaSharp traz os nativos de Windows/macOS, mas NÃO o de Linux. Sem isto,
         consumidores e o CI no Linux quebram com DllNotFoundException: 'libSkiaSharp'.

         Era a variante .NoDependencies, que conta com o fontconfig do sistema. Isso funcionava no
         SkiaSharp 3, mas no 4 o Linux passou a não resolver fonte NENHUMA: texto renderizava zero pixel
         de tinta, MeasureText devolvia zero e o PDF saía sem fonte embutida — no Windows tudo passava.
         Trocado pela variante completa, que traz as dependências nativas em vez de depender do que o
         host tenha instalado. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

</Project>
