<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Reporting</RootNamespace>
    <AssemblyName>Reporting.Core</AssemblyName>
    <Description>OmniReport — pure domain model for banded report definitions.</Description>
    <!-- Trava de documentacao: toda API publica deste projeto precisa de <summary>. O Replace levanta a
         supressao global de CS1591 (Directory.Build.props) so para ESTE projeto; junto com o
         TreatWarningsAsErrors das bibliotecas empacotaveis, o build falha enquanto houver membro publico sem
         doc — e continua falhando se um novo chegar sem ela. Mesmo padrao do Reporting.CodeFirst (#208). -->
    <NoWarn>$(NoWarn.Replace(';CS1591','').Replace('CS1591',''))</NoWarn>
  </PropertyGroup>

</Project>
